days_week = ('Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday',
             'Saturday', 'Sunday')


def project_completion_day(day, days_to_completion):
    """
    This function calculates the day a project will be completed.

    It takes the current day and the number of days required to complete
    the project, and returns the resulting day of the week.

    Examples:
    >>> project_completion_day('Monday', 4)
    'Friday'

    >>> project_completion_day('Saturday', 2)
    'Monday'

    Parameters:
    - day (string): The starting day of the week.
    - days_to_completion (int): Number of days needed.

    Returns:
    - (string): The day of the week when the project finishes.
    """
    
    start_index = days_week.index(day)
    
    end_index = (start_index + days_to_completion) % 7
    
    return days_week[end_index]


# Unit tests
assert project_completion_day('Monday', 4) == 'Friday'
assert project_completion_day('Monday', 7) == 'Monday'
assert project_completion_day('Saturday', 2) == 'Monday'
assert project_completion_day('Saturday', 1) == 'Sunday'



"""
Log Parsing Exercise
"""

def parse_log_line(line):
    
    parts = line.split()
    
    timestamp = parts[0] + " " + parts[1]
    
    level = parts[2][1:-1]
    
    module = parts[3]
    
    message = " ".join(parts[4:])
    
    return (timestamp, level, module, message)



# Unit tests
line = '2024-03-05 14:32:15 [ERROR] database.py Connection timeout after 30s'

assert parse_log_line(line) == (
    '2024-03-05 14:32:15',
    'ERROR',
    'database.py',
    'Connection timeout after 30s'
)



