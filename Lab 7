def find_index(s, t):
    """
    This function finds the lowest index of character t in string s.

    If the character does not exist in the string, the function returns -1.

    Examples:
    >>> find_index("Abd", 'b')
    1

    >>> find_index("Abdccc", 'c')
    3

    Parameters:
    - s (string): The string to search in.
    - t (string): The character to find.

    Returns:
    - (int): The index of the first occurrence of t in s,
             or -1 if t is not found.
    """
    
    for i in range(len(s)):
        if s[i] == t:
            return i
            
    return -1


# Unit tests
assert find_index("Abd", 'b') == 1
assert find_index("Abdccc", 'c') == 3
assert find_index("Abd", 'w') == -1



